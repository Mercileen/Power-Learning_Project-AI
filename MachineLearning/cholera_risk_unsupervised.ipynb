# cholera_risk_unsupervised.ipynb

# 1. Import libraries
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt
import seaborn as sns

# 2. Load datasets
cholera = pd.read_csv("cholera_cases.csv")
water   = pd.read_csv("water_access.csv")
health  = pd.read_csv("health_expenditure.csv")
sanit   = pd.read_csv("sanitation.csv")

# 3. Inspect
print(cholera.head())
print(water.head())
print(health.head())
print(sanit.head())

# 4. Merge datasets (on Country + Year)
df = cholera.merge(water,   on=["Country","Year"], how="left") \
             .merge(health, on=["Country","Year"], how="left") \
             .merge(sanit,  on=["Country","Year"], how="left")

# 5. Clean / drop missing or impute
df = df.dropna()
# Optionally: df.fillna(method="ffill") or custom imputation

# 6. Select features for clustering
features = [
    "Water_Access_%",       # example column name
    "Sanitation_%",         # example
    "Health_Exp_perCapita", # example
    "Population_Density",   # if you include
    "Cholera_Cases"         # outcome-type feature (unsupervised)
]
X = df[features]

# 7. Normalize features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 8. Choose optimal number of clusters (Elbow Method)
inertia = []
K = range(1,10)
for k in K:
    km = KMeans(n_clusters=k, random_state=42)
    km.fit(X_scaled)
    inertia.append(km.inertia_)
plt.figure(figsize=(8,5))
plt.plot(K, inertia, marker='o')
plt.xlabel('Number of clusters k')
plt.ylabel('Inertia')
plt.title('Elbow Method – choose k')
plt.show()

# 9. Fit final K-Means
k_opt = 3  # e.g., choose 3 after elbow
kmeans = KMeans(n_clusters=k_opt, random_state=42)
clusters = kmeans.fit_predict(X_scaled)
df["Cluster"] = clusters

# 10. Analyze cluster means
cluster_summary = df.groupby("Cluster")[features].mean()
print(cluster_summary)

# 11. Visualise with PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
plt.figure(figsize=(8,6))
sns.scatterplot(x=X_pca[:,0], y=X_pca[:,1],
                hue=clusters, palette="viridis", s=100)
plt.title("Clusters of Cholera Risk (PCA 2-D)")
plt.xlabel("PCA Component 1")
plt.ylabel("PCA Component 2")
plt.show()

# 12. Save results
df.to_csv("cholera_risk_clusters.csv", index=False)
print("Saved clustered dataset.")
